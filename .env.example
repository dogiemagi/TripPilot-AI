OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Live Travel Data Providers (Optional - system uses realistic mock providers if not set)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_API_KEY=

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
